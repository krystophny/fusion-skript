    "latex": "\\frac{2 \\sqrt{- \\tan^{2}{\\left(\\delta \\right)} \\tan^{2}{\\left(\\phi \\right)} + 1} \\cos{\\left(\\delta \\right)} \\cos{\\left(\\phi \\right)} + 2 \\sin{\\left(\\delta \\right)} \\sin{\\left(\\phi \\right)} \\operatorname{acos}{\\left(- \\tan{\\left(\\delta \\right)} \\tan{\\left(\\phi \\right)} \\right)}}{2 \\pi}"
  },

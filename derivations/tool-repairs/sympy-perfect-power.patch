+
+
+def test_perfect_power_large_logarithm_backend():
+    # iroot may return a flint/gmpy integer too large for __float__.
+    from sympy import Rational, log, simplify
+    expression = 1000 * log(Rational(34369, 31250))
+    from decimal import Decimal
+    expected = float((Decimal(34369) / Decimal(31250)).ln() * 1000)
+    assert abs(float(simplify(expression).evalf()) - expected) < 1e-9

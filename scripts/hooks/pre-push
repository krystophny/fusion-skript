#!/usr/bin/env bash
# Opt in: git config core.hooksPath scripts/hooks
# Rebuild/test/export before every push; --release never runs from the hook.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
[[ "${FUSION_PUBLISH_IN_PROGRESS:-0}" == 1 ]] && exit 0
exec bash "$repo_root/scripts/publish.sh"

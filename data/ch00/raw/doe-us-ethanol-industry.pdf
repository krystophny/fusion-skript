      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Current State of the U S  Ethanol Industry</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq/>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The objective of this study is to provide a comprehensive overview of the state of the U.S. ethanol industry and to outline the major forces that will affect the development of the industry over the next decade.&#xD;&#xA; &#xD;&#xA;</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
